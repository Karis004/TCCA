# MongoDB connection. Use your own database in production.
# Examples:
# MONGODB_URI=mongodb+srv://user:password@example.mongodb.net
# MONGODB_URI=mongodb://host.docker.internal:27017
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=tcca

# Authentication. Local preview: http://localhost:3184 and a separate preview DB.
BETTER_AUTH_URL=https://tcca.duckdns.org
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_GOOGLE_EMAIL=
# Generate each independently: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep these stable across restarts and back them up outside Git.
BETTER_AUTH_SECRET=
AI_CONFIG_ENCRYPTION_KEY=
ALLOW_NEW_USERS=true

# Optional legacy owner-only import. Other users never use these credentials.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Exchange rate API.
# Default endpoint works without a key. Set FX_API_KEY only if you use ExchangeRate-API's keyed endpoint.
FX_API_BASE_URL=https://open.er-api.com/v6/latest
FX_API_KEY=
